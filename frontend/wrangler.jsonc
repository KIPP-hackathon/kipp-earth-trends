{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kipp-earth-trends",
  "account_id": "3e63b6e6a2abfe1cd84373737a65b54f",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "placement": { "region": "gcp:us-east4" },
  "vars": {
    "WORKER_ORIGIN": "https://kipp-earth-trends.lucas-henrique-tai.workers.dev"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": false },
}
