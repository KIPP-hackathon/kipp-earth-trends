{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "functions": {
    "api/earth.ts": {
      "maxDuration": 60
    },
    "api/assistant.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/earth/:path*",
      "destination": "/api/earth?__path=:path*"
    }
  ]
}
