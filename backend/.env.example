DATA_PROVIDER=databricks-sql
DATABRICKS_HOST=https://8259554586019913.3.gcp.databricks.com
DATABRICKS_WAREHOUSE_ID=74a8d94611137690
# Cloud Run uses google-id with the attached SA; local development uses oauth-m2m.
DATABRICKS_AUTH_TYPE=oauth-m2m
# Configure credentials only in an ignored local .env or Secret Manager.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATA_CATALOG=earth-trend-data
DATA_SCHEMA=refined
PORT=8080
